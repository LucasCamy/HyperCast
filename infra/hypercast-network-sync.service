[Unit]
Description=Synchronize HyperCast public IPv4 and Cloudflare TURN DNS
Wants=network-online.target
After=network-online.target k3s.service

[Service]
Type=oneshot
User=root
UMask=0077
RuntimeDirectory=hypercast-network
Environment=HOME=/run/hypercast-network
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /etc/hypercast/sync_public_network.py --apply
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/hypercast /run

